# GameHub_2.0 Node backend - copy to .env and fill. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.1dzqotc.mongodb.net/gamehub_2_0?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=gamehub_2_0
# Optional. Only needed when startup fails with `querySrv ECONNREFUSED`
# (Node's resolver is pointed at a dead local DNS). Example: 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
FRONTEND_URL=http://localhost:5500
PORT=8000
NODE_ENV=development
GOOGLE_CLIENT_ID=<your>.apps.googleusercontent.com
# Optional: Google Calendar sync for accepted reservations (service account).
# Enable "Google Calendar API" in Google Cloud, create a service-account key,
# then share the GameHub calendar with the service-account email
# ("Make changes to events"). Leave blank to disable calendar sync.
# Verify the setup from server/ with: npm run check:calendar
GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com
GOOGLE_CALENDAR_CLIENT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
MAIL_USER=<sender>@gmail.com
MAIL_PASS=<16-letter-app-password>
MAIL_FROM=GameHub
# 1 = log outgoing mail instead of sending it (local development).
MAIL_DRY_RUN=0
SESSION_SECRET=<64-hex-chars>
SESSION_TTL_SECONDS=43200
AUTH_COOKIE_NAME=gh_session
TRUST_PROXY=0
