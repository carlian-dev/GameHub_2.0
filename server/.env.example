# GameHub_2.0 Node backend - copy to .env and fill. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.1dzqotc.mongodb.net/gamehub_2_0?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=gamehub_2_0
# Optional. Only needed when startup fails with `querySrv ECONNREFUSED`
# (Node's resolver is pointed at a dead local DNS). Example: 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
FRONTEND_URL=http://localhost:5500
PORT=8000
NODE_ENV=development
GOOGLE_CLIENT_ID=<your>.apps.googleusercontent.com
# Optional: Google Maps API key for the public landing-page map.
GOOGLE_MAPS_API_KEY=
# Optional reCAPTCHA v2 defaults. Used when the override below is blank, even
# if a legacy settings.recaptcha document exists. Leave both blank to keep the
# bot check off.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Required before an admin can save a secret credential (reCAPTCHA secret key,
# Google Calendar private key). Also encrypts super-admin authenticator (TOTP)
# secrets; when blank, a key derived from SESSION_SECRET is used instead.
# 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Secrets are stored AES-256-GCM-encrypted; losing this key means re-entering them.
SETTINGS_ENCRYPTION_KEY=
# Optional: Google Calendar sync for accepted reservations (service account).
# Enable "Google Calendar API" in Google Cloud, create a service-account key,
# then share the GameHub calendar with the service-account email
# ("Make changes to events"). Leave blank to disable calendar sync.
# Verify the setup from server/ with: npm run check:calendar
GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com
GOOGLE_CALENDAR_CLIENT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ---------------------------------------------------------------------------
# API integration admin overrides
# ---------------------------------------------------------------------------
# Settings > API writes the value entered by an administrator into the
# matching key below (server/.env is updated automatically). Leave a key blank
# to fall back to the default above, then to any legacy settings document
# value in MongoDB. "Restore defaults" on that page clears every override
# below, so the original keys apply again. Never commit the filled-in server/.env.
GOOGLE_AUTH_CLIENT_ID_OVERRIDE=
GOOGLE_MAPS_API_KEY_OVERRIDE=
GOOGLE_CALENDAR_ID_OVERRIDE=
GOOGLE_CALENDAR_CLIENT_EMAIL_OVERRIDE=
GOOGLE_CALENDAR_PRIVATE_KEY_OVERRIDE=
RECAPTCHA_SITE_KEY_OVERRIDE=
RECAPTCHA_SECRET_KEY_OVERRIDE=
MAIL_USER=<sender>@gmail.com
MAIL_PASS=<16-letter-app-password>
MAIL_FROM=GameHub
# 1 = log outgoing mail instead of sending it (local development).
MAIL_DRY_RUN=0
# Also derives the super-admin authenticator (TOTP) encryption key when
# SETTINGS_ENCRYPTION_KEY is blank, so it stays required.
SESSION_SECRET=<64-hex-chars>
# Signs the stateless auth JWT (HS256). Blank = reuse SESSION_SECRET; set a
# dedicated value so rotating one secret does not invalidate the other.
JWT_SECRET=<64-hex-chars>
# Auth token lifetime in seconds (default 43200 = 12h). There is no server-side
# session: logging out clears the cookie and bumps users.tokenVersion, which
# rejects every token issued before that moment.
JWT_TTL_SECONDS=43200
# HttpOnly cookie that carries the JWT (the frontend never reads it).
AUTH_COOKIE_NAME=gh_token
# Number of proxy hops in front of Express (0 = direct). Rate limiting keys
# anonymous traffic by req.ip, so this must match your deployment or every
# client behind a proxy shares one bucket.
TRUST_PROXY=0
# ---------------------------------------------------------------------------
# Rate limiting (express-rate-limit; per-process in-memory counters)
# ---------------------------------------------------------------------------
# 0 = disable every limiter (contract tests set this automatically).
RATE_LIMIT_ENABLED=1
# Global /api budget per IP (runs before the JSON body parser).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Login / authenticator changes / register / invite lookup defaults.
# Super Admin > Login protection can override these at runtime.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# POST/PUT/PATCH/DELETE budget per RATE_LIMIT_WINDOW_MS (per user/IP).
WRITE_RATE_LIMIT_MAX=60
# Per-action cooldown for every mutation (method + path + payload).
# ACTION_RATE_LIMIT_MAX = how many times that same action may fire in the window.
# ACTION_RATE_LIMIT_WINDOW_MS = how long the user waits (ms) after the limit.
# Defaults: 1 click, then a 1 second wait. Reads are never throttled here.
ACTION_RATE_LIMIT_WINDOW_MS=1000
ACTION_RATE_LIMIT_MAX=6
# Guest reservation create/status/cancel, per IP.
RESERVATION_RATE_LIMIT_WINDOW_MS=600000
RESERVATION_RATE_LIMIT_MAX=10
# Expensive staff reads: reservation/session/transaction list endpoints.
# Per user (IP when anonymous). The cashier dashboard polls some of these
# every 30s, so keep this comfortably above normal dashboard traffic.
STAFF_LIST_RATE_LIMIT_WINDOW_MS=60000
STAFF_LIST_RATE_LIMIT_MAX=60
# Admin income reports (daily/monthly/income). These pull transaction rows
# into memory, so the budget is deliberately smaller than the list budget.
REPORT_RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=20
# CSV report generation: builds the whole file in memory.
EXPORT_RATE_LIMIT_WINDOW_MS=600000
EXPORT_RATE_LIMIT_MAX=5
# Activity-log reads (admin audit trail and each user's own activity).
AUDIT_RATE_LIMIT_WINDOW_MS=60000
AUDIT_RATE_LIMIT_MAX=20
# Notification side effects: accepting a reservation (Google Calendar + mail),
# sending admin invitations (mail), and password-reset emails.
NOTIFICATION_RATE_LIMIT_WINDOW_MS=600000
NOTIFICATION_RATE_LIMIT_MAX=10
# Super-admin credential changes that call a provider (Maps/OAuth/Calendar).
INTEGRATION_RATE_LIMIT_WINDOW_MS=900000
INTEGRATION_RATE_LIMIT_MAX=10
# Self-service profile updates, including 2MB avatar payloads.
PROFILE_RATE_LIMIT_WINDOW_MS=60000
PROFILE_RATE_LIMIT_MAX=5
# Public health probe (each request performs a DB ping + count).
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX=30
