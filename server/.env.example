# GameHub_2.0 Node backend - copy to .env and fill. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.1dzqotc.mongodb.net/gamehub_2_0?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=gamehub_2_0
# Optional. Only needed when startup fails with `querySrv ECONNREFUSED`
# (Node's resolver is pointed at a dead local DNS). Example: 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
FRONTEND_URL=http://localhost:5500
PORT=8000
NODE_ENV=development
GOOGLE_CLIENT_ID=<your>.apps.googleusercontent.com
# Optional: Google Maps API key for the public landing-page map.
GOOGLE_MAPS_API_KEY=
# Optional reCAPTCHA v2 defaults. Used when the override below is blank, even
# if a legacy settings.recaptcha document exists. Leave both blank to keep the
# bot check off.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional PayMongo defaults. Values saved in Settings > API go to the
# matching *_OVERRIDE keys below.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: Google Gemini AI API key for AI assistant features.
# Generate one from Google AI Studio (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=
# Required before an admin can save a secret credential (reCAPTCHA secret key,
# Google Calendar private key). 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Secrets are stored AES-256-GCM-encrypted; losing this key means re-entering them.
SETTINGS_ENCRYPTION_KEY=
# Optional: Google Calendar sync for accepted reservations (service account).
# Enable "Google Calendar API" in Google Cloud, create a service-account key,
# then share the GameHub calendar with the service-account email
# ("Make changes to events"). Leave blank to disable calendar sync.
# Verify the setup from server/ with: npm run check:calendar
GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com
GOOGLE_CALENDAR_CLIENT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ---------------------------------------------------------------------------
# API integration admin overrides
# ---------------------------------------------------------------------------
# Settings > API writes the value entered by an administrator into the
# matching key below (server/.env is updated automatically). Leave a key blank
# to fall back to the default above, then to any legacy settings document
# value in MongoDB. Never commit the filled-in server/.env.
GOOGLE_AUTH_CLIENT_ID_OVERRIDE=
GOOGLE_MAPS_API_KEY_OVERRIDE=
GOOGLE_CALENDAR_ID_OVERRIDE=
GOOGLE_CALENDAR_CLIENT_EMAIL_OVERRIDE=
GOOGLE_CALENDAR_PRIVATE_KEY_OVERRIDE=
RECAPTCHA_SITE_KEY_OVERRIDE=
RECAPTCHA_SECRET_KEY_OVERRIDE=
PAYMONGO_SECRET_KEY_OVERRIDE=
PAYMONGO_WEBHOOK_SECRET_OVERRIDE=
GEMINI_API_KEY_OVERRIDE=
MAIL_USER=<sender>@gmail.com
MAIL_PASS=<16-letter-app-password>
MAIL_FROM=GameHub
# 1 = log outgoing mail instead of sending it (local development).
MAIL_DRY_RUN=0
SESSION_SECRET=<64-hex-chars>
SESSION_TTL_SECONDS=43200
AUTH_COOKIE_NAME=gh_session
TRUST_PROXY=0
